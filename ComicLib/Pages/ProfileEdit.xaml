<Page x:Class="ComicLib.Pages.ProfileEdit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComicLib"
      xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1100"
      Title="ProfileEdit">

    <Page.Resources>
        
    </Page.Resources>

    <Grid>
        <Border Margin="20, 20, 20, 60"
                Background="White"
                CornerRadius="4">

            <Border.Effect>
                <DropShadowEffect ShadowDepth="0.5" Opacity="0.2" 
                                  BlurRadius="10" />
            </Border.Effect>

            <ScrollViewer>
                <StackPanel Margin="17, 0, 0, 0">

                    <!-- Avatar Edit -->
                    <TextBlock Text="Аватар"
                               Style="{StaticResource HeaderTextBlock}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <Grid Height="150" Width="150"
                              AllowDrop="True" 
                              Drop="Image_Drop"
                              Background="Transparent">

                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="5">

                                <material:PackIcon 
                                    Kind="CloudDownload"
                                    HorizontalAlignment="Center"
                                    Height="25" Width="25"/>
                                <TextBlock 
                                    Text="Перетащите сюда изображение для загрузки"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                    FontSize="15"/>

                            </StackPanel>

                            <Rectangle Stroke="Black" 
                                       StrokeThickness="2"
                                       StrokeDashArray="4" 
                                       RadiusX="5" RadiusY="5"/>
                        </Grid>

                        <Grid Margin="30, 0, 0, 0">
                            <Border Background="White"
                                    CornerRadius="2">

                                <Border.Effect>
                                    <DropShadowEffect 
                                        ShadowDepth="0.5" Opacity="0.2" 
                                        BlurRadius="10" />
                                </Border.Effect>

                                <Image x:Name="ava"
                                       Stretch="Fill"
                                       Width="150" Height="150"/>

                            </Border>
                        </Grid>

                    </StackPanel>

                    <!-- Nickname Edit -->
                    <TextBlock Text="Никнейм"
                               Style="{StaticResource HeaderTextBlock}"/>

                </StackPanel>

            </ScrollViewer>
        </Border>
    </Grid>
</Page>
