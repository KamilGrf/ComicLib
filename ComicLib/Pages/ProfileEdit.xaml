<Page x:Class="ComicLib.Pages.ProfileEdit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComicLib"
      xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"    
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1100"
      Title="ProfileEdit"
      KeepAlive="False"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style x:Key="BorderStyle" TargetType="Border">

            <Setter Property="Width" Value="1000"/>
            <Setter Property="Height" Value="700"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextBoxBorderBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0, 60, 0, 0"/>

        </Style>

    </Page.Resources>


    <Grid>
        <!--#region Background Paper-->
        <Border Style="{StaticResource BorderStyle}"
                RenderTransformOrigin="0.5,0.5">

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="2.29"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect ShadowDepth="0.5" Opacity="0.4" 
                                  BlurRadius="10" />
            </Border.Effect>

        </Border>

        <Border Style="{StaticResource BorderStyle}"
                RenderTransformOrigin="0.5,0.5" Margin="50,75,50,0">

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-2.721"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect ShadowDepth="0.5" Opacity="0.4" 
                                  BlurRadius="10" />
            </Border.Effect>

        </Border>
        <!--#endregion-->

        <!-- Main Border -->
        <Border Style="{StaticResource BorderStyle}"
                Background="White"
                x:Name="mainBorder">

            <Border.Effect>
                <DropShadowEffect ShadowDepth="0.5" Opacity="0.4" 
                                  BlurRadius="10" />
            </Border.Effect>

            <Grid>

                <!-- Back Button -->
                <Button Height="60" Width="60"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="50"
                        Style="{StaticResource RegistrationButton}"
                        Click="GetBackClick">

                    <material:PackIcon Kind="NavigateBefore"
                                       Height="60" Width="60"/>
                </Button>

                <StackPanel>

                    <!-- Avatar Edit -->
                    <TextBlock Text="Аватар" Margin="0, 20, 0, 20"
                               Style="{StaticResource HeaderTextBlock}"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <Button Style="{StaticResource ImageDragAndDropPlace}"
                                Background="Transparent"
                                Height="150" Width="150"
                                Content="Нажмите или перетащите сюда изображение для загрузки"
                                Drop="ImageDrop"
                                Click="ImageOpenClick"/>

                        <!-- Avatar Image -->
                        <Grid Margin="30, 0, 0, 0">
                            <Border Background="White"
                                    CornerRadius="2">

                                <Border.Effect>
                                    <DropShadowEffect 
                                        ShadowDepth="0.5" Opacity="0.2" 
                                        BlurRadius="10" />
                                </Border.Effect>

                                <Grid>
                                    <material:PackIcon 
                                            Kind="AccountBoxOutline"
                                            Width="50"
                                            Height="50"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    <Image x:Name="ava"
                                           Source="{Binding Avatar, Converter={StaticResource ImgConvert}}"
                                           Stretch="Fill"
                                           Width="150" Height="150"/>

                                    <Button x:Name="deleteButton" Style="{StaticResource DeleteButton}"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Left"
                                            Height="35"
                                            Visibility="Visible"
                                            Click="DeleteButtonClick"/>
                                </Grid>

                            </Border>

                        </Grid>

                    </StackPanel>

                    <!-- Nickname Edit -->
                    <TextBlock Text="Никнейм"
                           Style="{StaticResource HeaderTextBlock}"/>
                    <TextBox x:Name="nick" 
                             Text="{Binding Name}"
                             BorderBrush="{StaticResource TextBoxBorderBrush}"
                             BorderThickness="2"
                             Style="{StaticResource DataEditTextBox}"
                             HorizontalAlignment="Center"
                             MaxLength="20"
                             Height="40" Width="450"
                             FontSize="20"/>

                    <!-- Email Edit -->
                    <TextBlock Text="Почта"
                           Style="{StaticResource HeaderTextBlock}"/>
                    <TextBox x:Name="email" Text="{Binding Email}"
                             BorderBrush="{StaticResource TextBoxBorderBrush}"
                             Style="{StaticResource DataEditTextBox}"
                             HorizontalAlignment="Center"
                             Height="40" Width="900"
                             MaxLength="70"
                             FontSize="20"/>

                    <!-- Password Edit -->
                    <TextBlock Text="Пароль"
                           Style="{StaticResource HeaderTextBlock}"/>
                    <TextBox x:Name="pas" Text="{Binding Password}"
                             BorderBrush="{StaticResource TextBoxBorderBrush}"
                             Style="{StaticResource DataEditTextBox}"
                             HorizontalAlignment="Center"
                             Height="40" Width="650"
                             MaxLength="30"
                             FontSize="20"/>

                    <!-- Save Button -->
                    <Button Style="{StaticResource RegistrationButton}"
                            Height="60" Width="200"
                            Margin="0, 60, 0, 0" FontSize="20"
                            Click="SaveClick">

                        <TextBlock Text="Сохранить"
                               FontSize="25"/>
                    </Button>

                </StackPanel>

                <!-- Rank Toggle Button -->
                <TextBlock Text="Разблокировать ранг"
                           TextWrapping="Wrap" Width="190"
                           TextAlignment="Center"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0, 20, 30, 0"
                           FontSize="25"/>
                <ToggleButton x:Name="rank" HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Height="30" Width="60"
                              Margin="0, 105, 95, 0"
                              Style="{StaticResource ToggleSwitchButton}"/>
            </Grid>

        </Border>
    </Grid>
</Page>
