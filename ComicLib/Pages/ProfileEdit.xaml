<Page x:Class="ComicLib.Pages.ProfileEdit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComicLib"
      xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1100"
      Title="ProfileEdit">

    <Page.Resources>
        <Style x:Key="BorderStyle" TargetType="Border">

            <Setter Property="Width" Value="1000"/>
            <Setter Property="Height" Value="700"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextBoxBorderBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0, 60, 0, 0"/>

        </Style>


    </Page.Resources>


    <Grid>
        <!--#region Background Paper-->
        <Border Style="{StaticResource BorderStyle}"
                RenderTransformOrigin="0.5,0.5">

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="2.29"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect ShadowDepth="0.5" Opacity="0.4" 
                                  BlurRadius="10" />
            </Border.Effect>

        </Border>

        <Border Style="{StaticResource BorderStyle}"
                RenderTransformOrigin="0.5,0.5" Margin="50,75,50,0">

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-2.721"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect ShadowDepth="0.5" Opacity="0.4" 
                                  BlurRadius="10" />
            </Border.Effect>

        </Border>
        <!--#endregion-->

        <Border Style="{StaticResource BorderStyle}"
                Background="White">

            <Border.Effect>
                <DropShadowEffect ShadowDepth="0.5" Opacity="0.4" 
                                  BlurRadius="10" />
            </Border.Effect>

            <Grid>
                <StackPanel>

                    <!-- Avatar Edit -->
                    <TextBlock Text="Аватар" Margin="0, 20, 0, 20"
                               Style="{StaticResource HeaderTextBlock}"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <Grid Height="150" Width="150"
                              AllowDrop="True" 
                              Drop="Image_Drop"
                              Background="Transparent">

                            <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="5">

                                <material:PackIcon 
                                    Kind="CloudDownload"
                                    HorizontalAlignment="Center"
                                    Height="25" Width="25"/>
                                <TextBlock 
                                    Text="Перетащите сюда изображение для загрузки"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                    FontSize="15"/>
                            </StackPanel>

                            <Rectangle Stroke="Black" 
                                   StrokeThickness="2"
                                   StrokeDashArray="4" 
                                   RadiusX="5" RadiusY="5"/>
                        </Grid>

                        <Grid Margin="30, 0, 0, 0">
                            <Border Background="White"
                                CornerRadius="2">

                                <Border.Effect>
                                    <DropShadowEffect 
                                    ShadowDepth="0.5" Opacity="0.2" 
                                    BlurRadius="10" />
                                </Border.Effect>

                                <Image x:Name="ava"
                                   Stretch="Fill"
                                   Width="150" Height="150"/>

                            </Border>
                        </Grid>

                    </StackPanel>

                    <!-- Nickname Edit -->
                    <TextBlock Text="Никнейм"
                           Style="{StaticResource HeaderTextBlock}"/>
                    <TextBox x:Name="nick" 
                         Style="{StaticResource DataEditTextBox}"
                         HorizontalAlignment="Center"
                         MaxLength="20"
                         Height="40" Width="450"
                         FontSize="20"/>

                    <!-- Email Edit -->
                    <TextBlock Text="Почта"
                           Style="{StaticResource HeaderTextBlock}"/>
                    <TextBox x:Name="email"
                         Style="{StaticResource DataEditTextBox}"
                         HorizontalAlignment="Center"
                         Height="40" Width="900"
                         MaxLength="70"
                         FontSize="20"/>

                    <!-- Password Edit -->
                    <TextBlock Text="Пароль"
                           Style="{StaticResource HeaderTextBlock}"/>
                    <TextBox x:Name="pas"
                         Style="{StaticResource DataEditTextBox}"
                         HorizontalAlignment="Center"
                         Height="40" Width="650"
                         MaxLength="30"
                         FontSize="20"/>

                    <!-- Save Button -->
                    <Button Style="{StaticResource RegistrationButton}"
                        Height="60" Width="200"
                        Margin="0, 60, 0, 0" FontSize="20"
                        Click="SaveClick">

                        <TextBlock Text="Сохранить"
                               FontSize="25"/>
                    </Button>

                </StackPanel>

                <!-- Rank Toggle Button -->
                <TextBlock Text="Разблокировать ранк"
                           TextWrapping="Wrap" Width="190"
                           TextAlignment="Center"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0, 20, 30, 0"
                           FontSize="25"/>
                <ToggleButton x:Name="rank" HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Height="30" Width="60"
                              Margin="0, 105, 95, 0"
                              Checked="RankChecked"
                              Style="{StaticResource ToggleSwitchButton}"/>
            </Grid>
            
        </Border>


        
    </Grid>
</Page>
