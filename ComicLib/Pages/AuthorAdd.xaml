<Page x:Class="ComicLib.Pages.AuthorAdd"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComicLib.Pages"
      xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="469"
      Title="AuthorAdd">

    <Grid Background="White">

        <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource HeaderTextBlock}"
                       Text="Фотография"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <!-- Image Drag And Drop Place -->
                <Button Style="{StaticResource ImageDragAndDropPlace}"
                        Content="Нажмите или перетащите сюда изображение для загрузки"
                        Drop="ImageDrop" Height="150"
                        Click="ImageOpenClick"/>

                <!-- Avatar Image -->
                <Grid Margin="30, 0, 0, 0">
                    <Border Background="White"
                            CornerRadius="2">

                        <Border.Effect>
                            <DropShadowEffect 
                                ShadowDepth="0.5" Opacity="0.2" 
                                BlurRadius="10" />
                        </Border.Effect>

                        <Grid>
                            <material:PackIcon 
                                Kind="FileImageOutline"
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                            <Image x:Name="photo"
                                    Source="{Binding Avatar, Converter={StaticResource ImgConvert}}"
                                    Stretch="Fill"
                                    Width="150" Height="150"/>
                            <Button x:Name="deleteButton" Style="{StaticResource DeleteButton}"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Left"
                                    Height="35"
                                    Visibility="Visible"
                                    Click="DeleteButtonClick"/>
                        </Grid>

                    </Border>
                </Grid>
            </StackPanel>

            <!-- Author Name -->
            <TextBlock Style="{StaticResource HeaderTextBlock}"
                       Text="Имя или псевдоним"/>
            <TextBox x:Name="name" 
                     Style="{StaticResource DataEditTextBox}"
                     FontSize="15"
                     Height="40"
                     MaxLength="20"
                     Margin="50, 0"/>

            <!-- Author Info -->
            <TextBlock Style="{StaticResource HeaderTextBlock}"
                       Text="Описание"/>
            <TextBox x:Name="info" 
                     Style="{StaticResource DataEditTextBox}"
                     Margin="50, 0"
                     FontSize="15"
                     Padding="10"
                     HorizontalContentAlignment="Left"
                     VerticalContentAlignment="Top"
                     MaxLength="500"
                     TextWrapping="Wrap"
                     Height="150"/>

            <StackPanel Orientation="Horizontal"
                        Margin="0, 40"
                        Height="50"
                        HorizontalAlignment="Center">

                <!-- Cancel Button -->
                <Button Style="{StaticResource RegistrationButton}"
                        Width="150"
                        Click="CancelClick">

                    <TextBlock Text="Отмена"
                               FontSize="22"/>
                </Button>

                <!-- Save Button -->
                <Button Style="{StaticResource RegistrationButton}"
                        Width="150" 
                        Margin="55, 0, 0, 0" 
                        Click="SaveClick">

                    <TextBlock Text="Сохранить"
                           FontSize="22"/>
                </Button>

            </StackPanel>
        </StackPanel>

    </Grid>
</Page>
