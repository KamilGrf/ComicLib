<Page x:Class="ComicLib.Pages.ReadComicPages"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:ComicLib.Pages"
      xmlns:allLocal="clr-namespace:ComicLib"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1100"
      Title="ReadComicPages"
      Unloaded="PageUnloaded">

    <!-- Page Template -->
    <Page.Template>
        <ControlTemplate TargetType="Page">

            <Border CornerRadius="0, 0, 3, 3"
                    Background="#FF212121">
                <ContentPresenter/>
            </Border>

        </ControlTemplate>
    </Page.Template>

    <Grid x:Name="mainGrid">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Visible"
                      Margin="5">
            <Grid>

                <!-- Vertical Comic Pages List -->
                <ListView x:Name="pages" 
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="False"
                          Background="Transparent"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Center"
                          BorderThickness="0"
                          Margin="100, 30">

                    <!-- Template For The Top Scroll Viewer -->
                    <ListView.Template>
                        <ControlTemplate>
                            <ItemsPresenter></ItemsPresenter>
                        </ControlTemplate>
                    </ListView.Template>

                    <!-- List View Item Panel Template -->
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel x:Name="wrp" 
                                       Orientation="Horizontal"
                                       IsItemsHost="True"
                                       HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <!-- List View Item Template -->
                    <ListView.Resources>
                        <ControlTemplate x:Key="ListViewPageItem"
                                         TargetType="ListViewItem">

                            <Grid Margin="1, 0, 1, 40"
                                  MinWidth="50">
                                <WrapPanel>
                                    <Border CornerRadius="2">
                                        <Border.Effect>
                                            <DropShadowEffect 
                                                ShadowDepth="0.5" Opacity="0.2" 
                                                BlurRadius="10" />
                                        </Border.Effect>

                                        <Grid>
                                            <!-- Page Image -->
                                            <Image Source="{Binding Photo, Converter={StaticResource ImgConvert}}"
                                                   Stretch="Uniform"
                                                   MaxHeight="1600"/>

                                            <!-- Page Number -->
                                            <Border Background="#FF232323"
                                                    CornerRadius="2"
                                                    Opacity="0.8"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Right"
                                                    Margin="10">
                                                <TextBlock Text="{Binding Number}"
                                                           FontSize="30"
                                                           Foreground="White"
                                                           Margin="10, 5"
                                                           FontWeight="Bold">
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </WrapPanel>
                            </Grid>
                        </ControlTemplate>

                        <Style TargetType="ListViewItem">
                            <Setter Property="Template" Value="{StaticResource ListViewPageItem}"/>
                        </Style>

                    </ListView.Resources>
                </ListView>
            </Grid>
        </ScrollViewer>

        <!-- Back Button -->
        <Button Height="80" Width="80"
                Margin="10"
                Style="{StaticResource ComicReadButtonTemplate}"
                Background="#FF404040"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="GoBackClick">
            <material:PackIcon Kind="NavigateBefore"
                               Foreground="White"
                               Height="50" Width="50"/>
        </Button>
    </Grid>
</Page>
