<Page x:Class="ComicLib.Pages.ComicListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComicLib.Pages"
      xmlns:loc="clr-namespace:ComicLib"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1100"
      Title="ComicListPage"
      x:Name="mainPage"
      SizeChanged="MainPageSizeChanged">

    <Page.CacheMode>
        <BitmapCache/>
    </Page.CacheMode>
    
    <Grid>
        
        <DockPanel x:Name="dp" Margin="50"
                   LastChildFill="False">

            <Border Background="White"
                    CornerRadius="5">
                <ListView x:Name="comicList"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          DockPanel.Dock="Left"
                          BorderThickness="0"
                          Width="800"
                          Padding="10, 20, 10, 20">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel x:Name="wrp" 
                                       Orientation="Horizontal"
                                       IsItemsHost="True"
                                       HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.Resources>
                        <ControlTemplate x:Key="listViewComicItem"
                                        TargetType="ListViewItem">

                            <Border x:Name="brd" 
                                    Background="Gainsboro"
                                    CornerRadius="5"
                                    Padding="5"
                                    Margin="10"
                                    Width="189">
                                <WrapPanel>
                                    <Grid>

                                        <Image Source="{Binding Cover, Converter={StaticResource ImgConvert}}"
                                                Stretch="Fill"/>

                                        <Border VerticalAlignment="Bottom"
                                                HorizontalAlignment="Stretch"
                                                Height="150">
                                            <Border.Background>
                                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                    <GradientStop Color="Black" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <Border Background="Transparent">

                                            <Border.Effect>
                                                <DropShadowEffect 
                                                    ShadowDepth="1" Opacity="0.7" 
                                                    BlurRadius="10" />
                                            </Border.Effect>

                                            <TextBlock Text="{Binding Title}"
                                                        Margin="2, 0, 2, 4"
                                                        FontSize="18"
                                                        Foreground="White"
                                                        FontWeight="Bold"
                                                        VerticalAlignment="Bottom"
                                                        TextWrapping="Wrap"
                                                        HorizontalAlignment="Center" 
                                                        OpacityMask="Black">
                                            </TextBlock>
                                        </Border>

                                    </Grid>
                                </WrapPanel>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter TargetName="brd" Property="Background" Value="Gray"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                        <Style TargetType="ListViewItem">
                            <Setter Property="Template" Value="{StaticResource listViewComicItem}"/>
                        </Style>

                    </ListView.Resources>
                </ListView>
            </Border>

            <Border x:Name="filterBorder" Width="300" 
                    DockPanel.Dock="Right"
                    Background="White"
                    CornerRadius="5"
                    Margin="20, 0, 0, 0">

            </Border>

        </DockPanel>
    </Grid>
</Page>
