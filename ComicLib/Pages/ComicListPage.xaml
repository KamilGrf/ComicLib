<Page x:Class="ComicLib.Pages.ComicListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComicLib.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1100"
      Title="ComicListPage"
      x:Name="mainPage"
      SizeChanged="MainPageSizeChanged">

    <Grid>
        
        <DockPanel x:Name="dp" Margin="50"
                   LastChildFill="False">

            <Border Background="White"
                    CornerRadius="5">
                <ListView x:Name="comicList"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          DockPanel.Dock="Left"
                          BorderThickness="0"
                          Width="800">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel x:Name="wrp" 
                                       Orientation="Horizontal"
                                       IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemTemplate>
                        <DataTemplate>

                            <Border x:Name="brd" 
                                    Background="Gainsboro"
                                    CornerRadius="5"
                                    Padding="5"
                                    Width="335">
                                <WrapPanel>
                                    <TextBlock Text="Title: " />
                                    <TextBlock Text="{Binding Title}" 
                                       TextWrapping="Wrap"
                                       FontWeight="Bold" />
                                    <TextBlock Text=", " />
                                    <TextBlock Text="Info: " />
                                    <TextBlock Text="{Binding Info}" 
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                                    <TextBlock Text=" (" />
                                    <TextBlock Text="{Binding Year}"/>
                                    <TextBlock Text=")" />
                                </WrapPanel>
                            </Border>

                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
            

            <Border x:Name="filterBorder" Width="300" 
                    DockPanel.Dock="Right"
                    Background="White"
                    CornerRadius="5"
                    Margin="20, 0, 0, 0">

            </Border>

        </DockPanel>
    </Grid>
</Page>
