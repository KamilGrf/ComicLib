<Page x:Class="ComicLib.Pages.MyComicAdds"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:ComicLib.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1100"
      Title="MyComicAdds"
      Unloaded="PageUnloaded">

    <Grid x:Name="mainGrid">

        <DockPanel Margin="30, 70, 100, 70"
                   VerticalAlignment="Top"
                   MaxWidth="1070"> 
            
            <!-- Back Button -->
            <Button Style="{StaticResource RegistrationButton}"
                    Width="60"
                    Margin="0, 0, 10, 0"
                    Click="BackClick">
                <material:PackIcon Kind="NavigateBefore"
                                    Height="60" Width="60"/>
            </Button>

            <!-- Filter Text Box -->
            <Border CornerRadius="4"
                    Background="White"
                    Height="60" 
                    VerticalAlignment="Top">

                <Grid x:Name="filterGrid" Margin="15, 10"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    
                    <TextBlock x:Name="filterBack" Text="Фильтр по названию"
                               Opacity="0.5"
                               FontSize="18"
                               VerticalAlignment="Center"
                               Margin="20, 0"/>

                    <TextBox x:Name="comicFilter"
                             MaxLength="15"
                             FontFamily="Comic Sans MS"
                             VerticalContentAlignment="Center"
                             FontSize="18" Padding="10, 0"
                             Background="Transparent"
                             TextChanged="ComicFilterTextChanged"
                             Style="{StaticResource SearchTextBox}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"/>
                </Grid>
            </Border>
        </DockPanel>
        
        <!-- Main Content -->
        <Border CornerRadius="4"
                Background="White"
                Margin="100, 150"
                MaxWidth="1000">

            <Grid Margin="20">

                <!-- Header Text -->
                <TextBlock x:Name="header" 
                           Text="Мои добавленные комиксы:"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="20" FontWeight="Bold"/>

                <!-- Horizontal Splitter -->
                <Rectangle x:Name="splitter" 
                           Height="2"
                           Fill="{StaticResource MainOrangeBrush}"
                           RadiusX="1" RadiusY="1"
                           VerticalAlignment="Top"
                           Margin="20, 40, 20, 0"/>

                <!-- No Elements Text Block -->
                <TextBlock x:Name="noElements" 
                           Text="Нет элементов"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           Visibility="Hidden"/>

                <!-- Favourite Comics -->
                <ListBox x:Name="favouriteComic" 
                         Visibility="Hidden"
                         ScrollViewer.CanContentScroll="False"
                         Background="Transparent"
                         Style="{StaticResource ComicsList}"
                         BorderThickness="0"
                         Margin="0, 50, 0, 0"
                         VerticalAlignment="Stretch"
                         SelectionMode="Single"
                         SelectionChanged="FavouriteComicSelectionChanged">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" 
                                        Height="102">

                                <!-- Comic Cover Image -->
                                <Image Source="{Binding Comic.Cover, Converter={StaticResource ImgConvert}}"
                                       Stretch="Fill"
                                       Width="60" Height="90"
                                       Margin="5, 5, 20, 5">
                                    <Image.Effect>
                                        <DropShadowEffect/>
                                    </Image.Effect>
                                </Image>

                                <!-- Comic Title -->
                                <TextBlock Text="{Binding Comic.Title}"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>

                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- My Comic Adds -->
                <ListBox x:Name="editComic" 
                         ScrollViewer.CanContentScroll="False"
                         Background="Transparent"
                         Style="{StaticResource ComicsList}"
                         BorderThickness="0"
                         Margin="0, 50, 0, 0"
                         VerticalAlignment="Stretch"
                         Visibility="Visible"
                         SelectionMode="Single"
                         SelectionChanged="EditComicSelectionChanged">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" 
                                        Height="102">

                                <!-- Comic Cover Image -->
                                <Image Source="{Binding Cover, Converter={StaticResource ImgConvert}}"
                                       Stretch="Fill"
                                       Width="60" Height="90"
                                       Margin="5, 5, 20, 5">
                                    <Image.Effect>
                                        <DropShadowEffect/>
                                    </Image.Effect>
                                </Image>

                                <!-- Comic Title -->
                                <TextBlock Text="{Binding Title}"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>

                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Page>
