<Page x:Class="ComicLib.Pages.ComicEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComicLib.Pages"
      xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1100"
      Title="ComicEditPage"
      PreviewMouseDown="PageMouseDown">

    <Grid>
        <Border CornerRadius="4"
                Background="White"
                Margin="50, 50, 50 ,60">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--#region Column 1-->
                <StackPanel>
                    
                    <!-- Back Button -->
                    <Grid>
                        
                        <Button Height="60" Width="60"
                                HorizontalAlignment="Left"
                                Margin="50, 50, 0, 20"
                                Style="{StaticResource RegistrationButton}"
                                Click="BackClick">
                            <material:PackIcon Kind="NavigateBefore"
                                           Height="60" Width="60"/>
                        </Button>

                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="50, 50, 50, 20"
                                Style="{StaticResource ComicDeleteButton}"
                                Height="60" Width="60" 
                                Click="ComicDeleteButton">
                            <material:PackIcon Kind="Trash"
                                       Foreground="#FFF52828"
                                       Height="50" Width="50"/>
                        </Button>

                    </Grid>
                    

                    <Grid Margin="0, 20, 0, 0" 
                          Width="250" Height="380">
                        <!-- Comic Cover Image -->
                        <Image Source="{Binding Cover, Converter={StaticResource ImgConvert}}"/>

                        <!-- Image Place -->
                        <Rectangle Stroke="Black"
                                   StrokeThickness="2"
                                   StrokeDashArray="4" 
                                   RadiusX="5" RadiusY="5"/>
                    </Grid>

                    <Grid Margin="50, 10, 50, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- Comic Pages Edit Button -->
                        <Button Style="{StaticResource StandartButton}"
                                Click="PagesAddClick">
                            <material:PackIcon Kind="Plus"
                                               Height="30" Width="30"/>
                        </Button>

                        <!-- Comic Edit Button -->
                        <Button Style="{StaticResource StandartButton}"
                                Grid.Column="1"
                                Click="ComicEditClick">
                            <material:PackIcon Kind="Edit"
                                               Height="25" Width="25"/>
                        </Button>
                    </Grid>
                </StackPanel>
                <!--#endregion-->

                <!-- Splitter Column 2 -->
                <Rectangle x:Name="splitter" 
                           Margin="0, 50"
                            Grid.Column="1"
                            Fill="{StaticResource MainOrangeBrush}"
                            RadiusX="1" RadiusY="1"/>

                <!--#region Column 3-->
                
                <StackPanel Orientation="Vertical"
                            Grid.Column="2"
                            Margin="0, 30">
                    <StackPanel.Resources>
                        <Style TargetType="StackPanel">
                            <Setter Property="Orientation" Value="Horizontal"/>
                            <Setter Property="Margin" Value="0, 0, 0, 20"/>
                        </Style>

                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="20"/>
                        </Style>

                        <Style TargetType="TextBlock" x:Key="BoldTextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="Margin" Value="20, 0"/>
                        </Style>

                    </StackPanel.Resources>

                    <!-- Comic Title -->
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="20, 20, 20, 30"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="30" FontWeight="Bold"
                               Text="{Binding Title}"/>

                    <!-- Authors -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <TextBlock Text="Автор/ы:"
                                   Style="{StaticResource BoldTextBlock}"/>

                        <ListView x:Name="authorList" 
                                  ItemsSource="{Binding ComicAndAuthor}"
                                  VerticalAlignment="Center"
                                  SelectionMode="Extended"
                                  BorderThickness="0"
                                  Focusable="False">

                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel x:Name="wrp" 
                                               Orientation="Horizontal"
                                               IsItemsHost="True"
                                               HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            <ListView.Resources>
                                <ControlTemplate x:Key="listViewComicItem"
                                                TargetType="ListViewItem">

                                    <Border x:Name="brd" Focusable="False"
                                            Background="{StaticResource MainOrangeBrush}"
                                            DataContext="{Binding Author}"
                                            Margin="0, 0, 10, 0"
                                            CornerRadius="5"
                                            Padding="5">

                                        <Border.ToolTip>
                                            <ToolTip Placement="Left">
                                                <ToolTip.Template>
                                                    <ControlTemplate TargetType="ToolTip">

                                                        <Border CornerRadius="4"
                                                                Background="White"
                                                                BorderThickness="1"
                                                                Margin="10"
                                                                BorderBrush="LightGray">

                                                            <Border.Effect>
                                                                <DropShadowEffect ShadowDepth="0.5" Opacity="0.4" 
                                                                                  BlurRadius="10" />
                                                            </Border.Effect>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="2"/>
                                                                    <ColumnDefinition/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Author Photo -->
                                                                <Image Source="{Binding Photo, Converter={StaticResource ImgConvert}}"
                                                                       Stretch="Uniform"
                                                                       VerticalAlignment="Center"
                                                                       Width="200"
                                                                       Margin="10, 5"/>

                                                                <!-- Vertical Splitter -->
                                                                <Rectangle Grid.Column="1"
                                                                           Fill="{StaticResource MainOrangeBrush}"
                                                                           Margin="0, 10"/>

                                                                <DockPanel Grid.Column="2">
                                                                    <!-- Author Name -->
                                                                    <TextBlock Text="{Binding Name}"
                                                                               DockPanel.Dock="Top"
                                                                               HorizontalAlignment="Center"
                                                                               FontWeight="Bold"
                                                                               FontSize="20"
                                                                               Margin="0, 5"/>
                                                                    <!-- Author Info -->
                                                                    <TextBlock Text="{Binding Info}"
                                                                               DockPanel.Dock="Bottom"
                                                                               Width="350"
                                                                               TextWrapping="Wrap"
                                                                               FontSize="16"
                                                                               Margin="15, 10"/>
                                                                </DockPanel>
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToolTip.Template>
                                            </ToolTip>
                                        </Border.ToolTip>

                                        <!-- Author Name -->
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   Margin="10, 0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>

                                <Style TargetType="ListViewItem">
                                    <Setter Property="Template" Value="{StaticResource listViewComicItem}"/>
                                </Style>

                            </ListView.Resources>
                        </ListView>
                    </StackPanel>

                    <!-- Year -->
                    <StackPanel>
                        <TextBlock Text="Год выхода:"
                                   Style="{StaticResource BoldTextBlock}"/>
                        <TextBlock Text="{Binding Year}"/>
                    </StackPanel>

                    <!-- Genres -->
                    <StackPanel>
                        <TextBlock Text="Жанры:"
                                   Style="{StaticResource BoldTextBlock}"/>
                        <ListView x:Name="genreList"
                                  ItemsSource="{Binding ComicAndGenre}"
                                  VerticalAlignment="Center"
                                  SelectionMode="Extended"
                                  BorderThickness="0"
                                  Focusable="False">

                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel x:Name="wrp" 
                                               Orientation="Horizontal"
                                               IsItemsHost="True"
                                               HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            <ListView.Resources>
                                <ControlTemplate x:Key="listViewComicItem"
                                                TargetType="ListViewItem">

                                    <Border x:Name="brd" Focusable="False"
                                            Background="{StaticResource MainOrangeBrush}"
                                            CornerRadius="5"
                                            Margin="0, 0, 10, 10"
                                            Padding="5">
                                        <!-- Genre Title -->
                                        <TextBlock Text="{Binding Genre.Title}"
                                                   Foreground="White"
                                                   Margin="10, 0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>

                                <Style TargetType="ListViewItem">
                                    <Setter Property="Template" Value="{StaticResource listViewComicItem}"/>
                                </Style>

                            </ListView.Resources>
                        </ListView>
                    </StackPanel>

                    <!-- Tags -->
                    <StackPanel>
                        <TextBlock Text="Теги:"
                                   Style="{StaticResource BoldTextBlock}"/>
                        <ListView x:Name="tagList"
                                  ItemsSource="{Binding ComicAndTag}"
                                  SelectionMode="Extended"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">

                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel x:Name="wrp" 
                                               Orientation="Horizontal"
                                               IsItemsHost="True"
                                               HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            <ListView.Resources>
                                <ControlTemplate x:Key="listViewComicItem"
                                         TargetType="ListViewItem">

                                    <Border x:Name="brd" Focusable="False"
                                            Background="{StaticResource MainOrangeBrush}"
                                            CornerRadius="5"
                                            Margin="0, 0, 10, 10"
                                            Padding="5">
                                        <!-- Tag Title -->
                                        <TextBlock Text="{Binding Tag.Title}"
                                                   Foreground="White"
                                                   Margin="10, 0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                </ControlTemplate>

                                <Style TargetType="ListViewItem">
                                    <Setter Property="Template" Value="{StaticResource listViewComicItem}"/>
                                </Style>

                            </ListView.Resources>
                        </ListView>
                    </StackPanel>

                    <!-- Info -->
                    <Grid>
                        <TextBlock Text="Описание:"
                                   Style="{StaticResource BoldTextBlock}"/>
                        <TextBlock Text="{Binding 
                                   StringFormat=____________\&#x20;\&#x20;{0}, 
                                   Path=Info}"
                                   Margin="21, 0"    
                                   TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
                <!--#endregion-->
            </Grid>
        </Border>
    </Grid>
</Page>
