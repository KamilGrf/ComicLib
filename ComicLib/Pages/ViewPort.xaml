<Page x:Class="ComicLib.Pages.ViewPort"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComicLib.Pages"
      xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      ShowsNavigationUI="False"
      d:DesignHeight="900" d:DesignWidth="1100"
      Title="ViewPort" WindowTitle="ViewPort">

    <Page.Template>
        <ControlTemplate TargetType="Page">
            <Border Background="{StaticResource ViewPortBackgroundBrush}"
                    CornerRadius="0, 0, 3, 3">
                <ContentPresenter/>
            </Border>
        </ControlTemplate>
    </Page.Template>


    <Page.Resources>
        <!--<Style TargetType="Button">
            <Style.Setters>
                <Setter Property="Button.Background" Value="Black" />
                <Setter Property="Button.Foreground" Value="White" />
                <Setter Property="Button.FontFamily" Value="Verdana" />
                <Setter Property="Button.Margin" Value="10" />
            </Style.Setters>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Click">
                    <EventTrigger.Actions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width" Duration="0:0:0:0.2" To="50" AutoReverse="True" />
                                <DoubleAnimation Storyboard.TargetProperty="Height" Duration="0:0:0:0.2" To="50" AutoReverse="True" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger.Actions>
                </EventTrigger>
            </Style.Triggers>
        </Style>-->
    </Page.Resources>
    
    
    <Grid>
        <Grid.RowDefinitions>
            <!--Title Bar-->
            <RowDefinition Height="50"/>
            <!--Other Content-->
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!--Title Bar-->
        <Grid Background="{StaticResource MainBlueBrush}"
              Height="50"
              VerticalAlignment="Top">

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>

            </Grid.ColumnDefinitions>

            <!--Profile Button-->
            <Button x:Name="b" Grid.Column="2"
                    Height="40" Width="40"
                    HorizontalAlignment="Right"
                    Margin="0, 0, 10, 0"
                    Click="ProfileIconClick">

                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        
                        <Border Background="Transparent">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Button.Template>

                <Image x:Name="profileIcon" 
                       Source="/Images/bam-icon.png"/>

            </Button>

        </Grid>

        <!--Profile Menu-->
        <Border x:Name="profileMenu" 
                Visibility="Visible"
                Background="White"
                CornerRadius="5"
                Grid.Row="1"
                Height="240" Width="250"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0, 10, 10, 0">

            <Border.Effect>
                <DropShadowEffect ShadowDepth="0.5" Opacity="0.4" 
                                  BlurRadius="10" />
            </Border.Effect>

            <StackPanel Margin="10"
                        Orientation="Vertical">

                <!--Style For ProfileMenu Buttons-->
                <StackPanel.Resources>

                    <Style TargetType="material:PackIcon">
                        <Setter Property="Width" Value="20"/>
                        <Setter Property="Height" Value="20"/>
                    </Style>

                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="10, 0"/>
                    </Style>
                    
                    <Style TargetType="Button">
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="back"
                                            Background="Transparent"
                                            CornerRadius="5">
                                        <ContentPresenter Margin="10, 0"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"/>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter TargetName="back" 
                                                    Property="Background"
                                                    Value="LightGray"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                </StackPanel.Resources>

                <!--#region Profile Menu Buttons-->
                <Button Click="ProfileClick">
                    <StackPanel Orientation="Horizontal">
                        <material:PackIcon Kind="User" />
                        <TextBlock Text="Профиль пользователя"/>
                    </StackPanel>
                </Button>

                <Button Click="MineBookmarksClick">
                    <StackPanel Orientation="Horizontal">
                        <material:PackIcon Kind="Bookmark"/>
                        <TextBlock Text="Мои закладки"/>
                    </StackPanel>
                </Button>

                <Button Click="MineCommentsClick">
                    <StackPanel Orientation="Horizontal">
                        <material:PackIcon Kind="Comment"/>
                        <TextBlock Text="Мои комментарии"/>
                    </StackPanel>
                </Button>

                <Button Click="SettingsClick">
                    <StackPanel Orientation="Horizontal">
                        <material:PackIcon Kind="Cog"/>
                        <TextBlock Text="Настройки"/>
                    </StackPanel>
                </Button>

                <Button Click="AccLeaveClick">
                    <StackPanel Orientation="Horizontal">
                        <material:PackIcon Kind="ExitToApp"
                                           Foreground="Red"/>
                        <TextBlock Text="Выйти"
                                   Foreground="Red"/>
                    </StackPanel>
                </Button>
                <!--#endregion-->

            </StackPanel>

        </Border>
    </Grid>
</Page>

