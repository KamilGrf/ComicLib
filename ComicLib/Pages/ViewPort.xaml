<Page x:Class="ComicLib.Pages.ViewPort"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComicLib.Pages"
      xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1100"
      Title="ViewPort" WindowTitle="ViewPort">

    <Page.Template>
        <ControlTemplate TargetType="Page">

            <Border CornerRadius="0, 0, 3, 3"
                    MouseDown="MainGridMouseDown"
                    Background="Transparent">
                
                <ContentPresenter/>
                
            </Border>

        </ControlTemplate>
    </Page.Template>


    <Page.Resources>

        <Style TargetType="StackPanel" x:Key="StackPanelStyle">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </Page.Resources>


    <Grid>
        
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="50"/>
            <!-- Other Content -->
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Background="{StaticResource MainBlueBrush}"
              Height="50"
              VerticalAlignment="Top">

            <Grid.ColumnDefinitions>

                <!-- Header Center Menu -->
                <ColumnDefinition Width="Auto"/>
                <!-- Search Link -->
                <ColumnDefinition Width="*"/>
                <!-- Header Right Menu -->
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <!--#region Header Center Menu -->
            <StackPanel Style="{StaticResource StackPanelStyle}"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Margin="10, 5">

                <!-- Catalog Button -->
                <Button Style="{StaticResource ViewPortHeaderButton}"
                        Click="CatalogClick">

                    <StackPanel Style="{StaticResource StackPanelStyle}"
                                Margin="10, 0">
                        <material:PackIcon Kind="Menu"
                                           Height="28" Width="28"/>
                        <TextBlock Text="Каталог"
                                   Margin="5, 0"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <material:PackIcon Kind="MenuDown"
                                           VerticalAlignment="Bottom"
                                           Height="25" Width="25"/>
                    </StackPanel>

                </Button>

                <!-- Find Button -->
                <Button Style="{StaticResource ViewPortHeaderButton}"
                        Margin="20, 0"
                        Click="SearchVisibleClick">

                    <StackPanel Style="{StaticResource StackPanelStyle}"
                                Margin="10, 0">
                        <material:PackIcon Kind="Magnify"
                                           Height="28" Width="28"/>
                        <TextBlock Text="Поиск"
                                   Margin="5, 0"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                    </StackPanel>

                </Button>

            </StackPanel>
            <!--#endregion-->

            <!--#region Search Link -->
            <Grid Margin="5, 5, 20, 5"
                  Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  x:Name="searchBorder"
                  Visibility="Visible">

                <!-- Search Link Background -->
                <Border Background="White"
                        CornerRadius="3"/>

                <!-- Search Link Back Text -->
                <TextBlock x:Name="backText"
                           Text="Поиск комикса"
                           Margin="40, 0"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Opacity="0.5"/>

                <!-- Search Link Text Box -->
                <TextBox x:Name="search"
                         VerticalContentAlignment="Center"
                         Padding="30, 5" MaxLength="70"
                         FontSize="20" FontFamily="Comic Sans MS"
                         Style="{StaticResource SearchTextBox}"
                         PreviewTextInput="SearchPreviewTextInput"
                         TextChanged="SearchTextChanged"
                         Background="Transparent"/>

                <!-- Search Button -->
                <Button Style="{StaticResource ViewPortProfileButton}"
                        Width="40"
                        HorizontalAlignment="Left">
                    <material:PackIcon Kind="Magnify"
                                    Height="28" Width="28"/>
                </Button>

                <!-- Close Button -->
                <Button Style="{StaticResource ViewPortProfileButton}"
                        Width="40"
                        HorizontalAlignment="Right"
                        Click="SearchVisibleClick">
                    <material:PackIcon Kind="WindowClose"
                                       Height="28" Width="28"/>
                </Button>

            </Grid>
            <!--#endregion-->


            <!--#region Header Right Menu -->
            <StackPanel Grid.Column="3"
                        Margin="10, 5"
                        FlowDirection="RightToLeft"
                        Style="{StaticResource StackPanelStyle}">

                <!-- Profile Button -->
                <Button HorizontalAlignment="Right"
                        Margin="0, 0, 10, 0" Width="40"
                        Click="ProfileIconClick"
                        Style="{StaticResource ViewPortProfileButton}">

                    <Image x:Name="profileIcon" 
                        Source="/Images/bam-icon.png"/>

                </Button>

                <!-- Bookmark Button -->
                <Button Style="{StaticResource ViewPortHeaderButton}"
                        Click="MineBookmarksClick"
                        Margin="15, 0" Width="40">

                    <material:PackIcon Kind="BookmarkBorder"
                                   Height="25" Width="25"/>

                </Button>

                <!-- Comic Add Button -->
                <Button Width="40"
                        Style="{StaticResource ViewPortHeaderButton}"
                        Click="MineBookmarksClick">

                    <material:PackIcon Kind="PencilAdd"
                                   Height="25" Width="25"/>

                </Button>

            </StackPanel>
            <!--#endregion-->

        </Grid>


        <!-- Other Page Content -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="29*"/>
                <ColumnDefinition Width="81*"/>
            </Grid.ColumnDefinitions>

            
            <!--#region Catalog Menu-->
            <StackPanel Width="250"
                        HorizontalAlignment="Left">
                
                <ListBox x:Name="catalog" Margin="10"
                         Style="{StaticResource ListBoxMenuTemplate}"
                         Padding="10"
                         MouseDown="MainGridMouseDown"
                         Visibility="Visible"
                         SelectionChanged="CatalogSelectionChanged">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       Margin="10, 0"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
                
            </StackPanel>
            <!--#endregion-->

            
            <!--#region Profile Menu -->
            <Button x:Name="profileMenu" 
                    Visibility="Visible"
                    Height="240" Width="250"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Grid.Column="1" Margin="0, 10, 10, 0"
                    Style="{StaticResource MenuTemplate}">

                <StackPanel Orientation="Vertical">

                    <!-- Style For ProfileMenu Buttons -->
                    <StackPanel.Resources>

                        <Style TargetType="material:PackIcon">
                            <Setter Property="Width" Value="20"/>
                            <Setter Property="Height" Value="20"/>
                        </Style>

                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10, 0"/>
                        </Style>

                        <Style TargetType="Button">
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="Margin" Value="2"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">

                                        <Border x:Name="back"
                                                Background="Transparent"
                                                CornerRadius="5">
                                            <ContentPresenter Margin="10, 0"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter TargetName="back" 
                                                    Property="Background"
                                                    Value="LightGray"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                    </StackPanel.Resources>

                    <!--#region Profile Menu Buttons -->
                    <Button Click="ProfileClick">
                        <StackPanel Orientation="Horizontal">
                            <material:PackIcon Kind="User" />
                            <TextBlock Text="Профиль пользователя"/>
                        </StackPanel>
                    </Button>

                    <Button Click="MineBookmarksClick">
                        <StackPanel Orientation="Horizontal">
                            <material:PackIcon Kind="Bookmark"/>
                            <TextBlock Text="Мои закладки"/>
                        </StackPanel>
                    </Button>

                    <Button Click="MineCommentsClick">
                        <StackPanel Orientation="Horizontal">
                            <material:PackIcon Kind="Comment"/>
                            <TextBlock Text="Мои комментарии"/>
                        </StackPanel>
                    </Button>

                    <Button Click="SettingsClick">
                        <StackPanel Orientation="Horizontal">
                            <material:PackIcon Kind="Cog"/>
                            <TextBlock Text="Настройки"/>
                        </StackPanel>
                    </Button>

                    <Button Click="AccLeaveClick">
                        <StackPanel Orientation="Horizontal">
                            <material:PackIcon Kind="ExitToApp"
                                           Foreground="Red"/>
                            <TextBlock Text="Выйти"
                                   Foreground="Red"/>
                        </StackPanel>
                    </Button>
                    <!--#endregion-->

                </StackPanel>

            </Button>
            <!--#endregion-->

        </Grid>
    </Grid>
</Page>

