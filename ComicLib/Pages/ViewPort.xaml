<Page x:Class="ComicLib.Pages.ViewPort"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComicLib.Pages"
      xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1100"
      Title="ViewPort" WindowTitle="ViewPort">

    <Page.Template>
        <ControlTemplate TargetType="Page">

            <Border CornerRadius="0, 0, 3, 3"
                    MouseDown="MainGridMouseDown"
                    Background="Transparent">

                <ContentPresenter/>

            </Border>

        </ControlTemplate>
    </Page.Template>


    <Page.Resources>

        <Style TargetType="StackPanel" x:Key="StackPanelStyle">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </Page.Resources>


    <Grid>

        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="50"/>
            <!-- Other Content -->
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Background="{StaticResource MainBlueBrush}"
              Height="50"
              VerticalAlignment="Top">

            <Grid.ColumnDefinitions>

                <!-- Header Center Menu -->
                <ColumnDefinition Width="Auto"/>
                <!-- Search Link -->
                <ColumnDefinition Width="*"/>
                <!-- Header Right Menu -->
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <!--#region Header Center Menu -->
            <StackPanel Style="{StaticResource StackPanelStyle}"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Margin="10, 5">

                <!-- Home Button -->
                <Button Style="{StaticResource ViewPortHeaderButton}"
                        Width="40"
                        Click="HomeClick"
                        Margin="0, 0, 20, 0">
                    <material:PackIcon 
                            Kind="Home"
                            Height="28" Width="28"/>
                </Button>

            </StackPanel>
            <!--#endregion-->

            <!--#region Header Right Menu -->
            <StackPanel Grid.Column="3"
                        Margin="10, 5"
                        FlowDirection="RightToLeft"
                        Style="{StaticResource StackPanelStyle}">

                <!-- Profile Button -->
                <Button HorizontalAlignment="Right"
                        Margin="0, 0, 10, 0" Width="40"
                        Click="ProfileIconClick"
                        Style="{StaticResource ViewPortProfileButton}">

                    <Grid>
                        <material:PackIcon 
                            Kind="Account"
                            Width="30"
                            Height="30"/>
                        <Image x:Name="profileIcon" 
                               Source="{Binding Avatar, Converter={StaticResource ImgConvert}}"
                               Stretch="Fill"/>
                    </Grid>
                </Button>

                <!-- Bookmark Button -->
                <Button Style="{StaticResource ViewPortHeaderButton}"
                        Click="MineBookmarksClick"
                        Margin="15, 0" Width="40">

                    <material:PackIcon 
                        Kind="BookmarkBorder"
                        Height="25" Width="25"/>
                </Button>

                <!-- Comic Add Button -->
                <Button x:Name="comicAdd" 
                        Width="40"
                        Style="{StaticResource ViewPortHeaderButton}"
                        Click="CreateComicClick">

                    <material:PackIcon 
                        Kind="PencilAdd"
                        Height="25" Width="25"/>
                </Button>

            </StackPanel>
            <!--#endregion-->

        </Grid>


        <!-- Other Page Content -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="29*"/>
                <ColumnDefinition Width="81*"/>
            </Grid.ColumnDefinitions>

            <Frame x:Name="viewFrame"
                   Grid.ColumnSpan="2"
                   NavigationUIVisibility="Hidden"
                   Focusable="False"/>

            <Grid Grid.Column="1"
                    Width="220"
                    Margin="0, 10, 70, 0"
                    HorizontalAlignment="Right">

                <!-- Comic Edit Menu -->
                <ListBox x:Name="editComic" 
                         Style="{StaticResource ListBoxMenuTemplate}"
                         Padding="10" Height="112"
                         VerticalAlignment="Top"
                         MouseDown="MainGridMouseDown"
                         Visibility="Visible"
                         SelectionMode="Single"
                         SelectionChanged="EditComicSelectionChanged">

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <material:PackIcon Kind="PlusBox"
                                               Height="20" Width="20"/>
                            <TextBlock Text="Добавить комикс"
                                       Margin="10, 0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <material:PackIcon Kind="ListStatus"
                                               Height="20" Width="20"/>
                            <TextBlock Text="Мои добавления"
                                       Margin="10, 0"/>
                            <Border CornerRadius="2"
                                    Background="Black"
                                    Width="15">
                                <TextBlock x:Name="numOfComics"
                                           HorizontalAlignment="Center"
                                           Text="1"
                                           Foreground="White"/>
                            </Border>

                        </StackPanel>
                    </ListBoxItem>

                </ListBox>

            </Grid>

            <!--#region Profile Menu -->
            <Button x:Name="profileMenu" 
                    Visibility="Hidden"
                    Height="160" Width="250"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Grid.Column="1" Margin="0, 10, 10, 0"
                    Style="{StaticResource MenuTemplate}">

                <StackPanel Orientation="Vertical">

                    <!-- Style For ProfileMenu Buttons -->
                    <StackPanel.Resources>

                        <Style TargetType="material:PackIcon">
                            <Setter Property="Width" Value="20"/>
                            <Setter Property="Height" Value="20"/>
                        </Style>

                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10, 0"/>
                        </Style>

                        <Style TargetType="Button">
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="Margin" Value="2"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">

                                        <Border x:Name="back"
                                                Background="Transparent"
                                                CornerRadius="5">
                                            <ContentPresenter Margin="10, 0"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter TargetName="back" 
                                                    Property="Background"
                                                    Value="LightGray"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                    </StackPanel.Resources>

                    <!--#region Profile Menu Buttons -->
                    <Button Click="ProfileClick">
                        <StackPanel Orientation="Horizontal">
                            <material:PackIcon Kind="User" />
                            <TextBlock Text="Профиль пользователя"/>
                        </StackPanel>
                    </Button>

                    <Button Click="MineBookmarksClick">
                        <StackPanel Orientation="Horizontal">
                            <material:PackIcon Kind="Bookmark"/>
                            <TextBlock Text="Мои закладки"/>
                        </StackPanel>
                    </Button>

                    <Button Click="AccLeaveClick">
                        <StackPanel Orientation="Horizontal">
                            <material:PackIcon Kind="ExitToApp"
                                           Foreground="Red"/>
                            <TextBlock Text="Выйти"
                                   Foreground="Red"/>
                        </StackPanel>
                    </Button>
                    <!--#endregion-->

                </StackPanel>

            </Button>
            <!--#endregion-->

        </Grid>
    </Grid>
</Page>