<Page x:Class="ComicLib.Pages.ComicComments"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComicLib.Pages"
      xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"       
      d:DesignHeight="740" d:DesignWidth="550"
      Title="ComicComments">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <Grid x:Name="mainGrid" 
              Background="White"
              MouseDown="PageMouseDown">

            <!-- No Com Text Block -->
            <TextBlock x:Name="noComments" 
                       Text="Нет ни одного комментария"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- Sort Element -->
            <StackPanel Margin="50, 25"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                
                <TextBlock Text="Сортировать:"
                           VerticalAlignment="Center"/>

                <Button Style="{StaticResource StandartButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top" Height="25"
                        Margin="10, 0"
                        Click="SortClick">
                    
                    <StackPanel Orientation="Horizontal"
                                Margin="5, 3"
                                VerticalAlignment="Center">
                        
                        <TextBlock x:Name="sort" 
                                   Text="Новые"
                                   Foreground="Black"/>
                        
                        <material:PackIcon Kind="ArrowSplitHorizontal"
                                           VerticalAlignment="Center"
                                           Margin="4, 1"/>
                    </StackPanel>
                </Button>
            </StackPanel>


            <StackPanel>
                
                <Grid Margin="50, 60, 50, 20"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top">
                    
                    <!-- Comment Back Text -->
                    <TextBlock x:Name="commentBackText" 
                               IsEnabled="False"
                               Text="Написать комментарий..."
                               Visibility="Visible"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               Margin="15, 14"
                               Opacity="0.5"/>

                    <!-- Comment Text Box -->
                    <TextBox x:Name="comment"
                             TextChanged="CommentTextChanged"
                             Background="Transparent"
                             Padding="10, 10, 10, 50"
                             FontSize="15"
                             TextAlignment="Left"
                             MaxLength="255"
                             MinHeight="30"
                             MaxHeight="279"
                             Style="{StaticResource DataEditTextBox}"
                             Height="Auto"
                             TextWrapping="Wrap"/>

                    <!-- Send Button -->
                    <Button Style="{StaticResource RegistrationButtonX2}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Height="30" Width="120"
                            Margin="0, 0, 20, 10"
                            Click="CommentAddClick">

                        <TextBlock Text="Отправить"
                                   Foreground="White"/>
                    </Button>
                </Grid>

                <!-- Horizontal Splitter -->
                <Rectangle Grid.Column="2"
                           Height="2"
                           Margin="50, 15"
                           Fill="{StaticResource MainOrangeBrush}"/>

                <!-- Comment List -->
                <StackPanel x:Name="commentsStack" Margin="50, 10"
                            Orientation="Vertical"/>

            </StackPanel>

            <!-- Sort Items List -->
            <Button x:Name="sortBack" Background="White"
                    Style="{StaticResource MenuTemplate}"
                    Visibility="Hidden"
                    Height="120" Width="164"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="146, 55">

                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Height" Value="30"/>
                            <Setter Property="Margin" Value="2"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">

                                        <Border x:Name="back"
                                                Background="Transparent"
                                                CornerRadius="2">
                                            <ContentPresenter Margin="5, 0"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter TargetName="back" 
                                                        Property="Background"
                                                        Value="LightGray"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <!-- Order By New -->
                    <Button Width="140"
                            Click="SortNewClick">
                        <TextBlock Text="Новые"/>
                    </Button>

                    <!-- Order By Old -->
                    <Button Click="SortOldClick">
                        <TextBlock Text="Старые"/>
                    </Button>

                    <!-- Order By Pop -->
                    <Button Click="SortPopClick">
                        <TextBlock Text="Популярные"/>
                    </Button>
                </StackPanel>
            </Button>

        </Grid>
    </ScrollViewer>
    
</Page>
