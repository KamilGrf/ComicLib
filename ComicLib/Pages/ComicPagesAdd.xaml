<Page x:Class="ComicLib.Pages.ComicPagesAdd"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComicLib.Pages"
      xmlns:allLocal="clr-namespace:ComicLib"
      xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1100"
      Title="ComicPagesAdd"
      Unloaded="Page_Unloaded"
      PreviewMouseDown="PageMouseDown">

    <Grid x:Name="mainGrid">
        <Border CornerRadius="4"
                Margin="60, 40, 60, 60"
                Background="White">

            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          Background="Transparent">
                <DockPanel>
                    
                    <!-- Save Button -->
                    <Button DockPanel.Dock="Bottom"
                            Height="60" Width="250"
                            Style="{StaticResource RegistrationButton}"
                            Margin="0, 0, 0, 30"
                            Click="SaveClick">
                        <TextBlock Text="Сохранить"
                                   FontSize="25"/>
                    </Button>
                    
                    <StackPanel Orientation="Horizontal"
                                Margin="10, 10, 5, 0"
                                DockPanel.Dock="Top">
                        
                        <!-- Back Button -->
                        <Button Style="{StaticResource RegularTextButton}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Click="GoBackClick">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        </Button>

                        <material:PackIcon Kind="ChevronDoubleRight"
                                           Height="20"
                                           Margin="10, 0"
                                           VerticalAlignment="Center"/>

                        <!-- Header Text -->
                        <TextBlock Text="Создание страниц"
                                   VerticalAlignment="Center"
                                   FontSize="17"/>
                    </StackPanel>

                    <Grid Margin="20, 40" 
                          DockPanel.Dock="Bottom">
                        
                        <!-- Horizontal Pages List -->
                        <ListView x:Name="pagesList"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  BorderThickness="0">

                            <!-- Template For The Top Scroll Viewer -->
                            <ListView.Template>
                                <ControlTemplate>
                                    <ItemsPresenter></ItemsPresenter>
                                </ControlTemplate>
                            </ListView.Template>

                            <!-- List View Item Panel Template -->
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel x:Name="wrp" 
                                               Orientation="Horizontal"
                                               IsItemsHost="True"
                                               HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            <!-- List View Item Template -->
                            <ListView.Resources>
                                <ControlTemplate x:Key="ListViewPageItem"
                                             TargetType="ListViewItem">

                                    <Grid Margin="20, 0, 20, 40"
                                          MinWidth="50">
                                        <WrapPanel>
                                            <Border CornerRadius="2">
                                                <Border.Effect>
                                                    <DropShadowEffect 
                                                        ShadowDepth="0.5" Opacity="0.2" 
                                                        BlurRadius="10" />
                                                </Border.Effect>

                                                <Grid>
                                                    <!-- Page Image -->
                                                    <Image Source="{Binding Photo, Converter={StaticResource ImgConvert}}"
                                                           Stretch="Uniform"
                                                           Height="220" Width="140" />

                                                    <!-- Delete Page Button -->
                                                    <Button Style="{StaticResource DeleteButton}"
                                                            VerticalAlignment="Top"
                                                            HorizontalAlignment="Left"
                                                            Height="35"
                                                            Visibility="Visible"
                                                            Click="DeleteButtonClick"/>

                                                    <!-- Page Number -->
                                                    <Border Background="#FF232323"
                                                            CornerRadius="2"
                                                            VerticalAlignment="Bottom"
                                                            HorizontalAlignment="Left"
                                                            Margin="5">
                                                        <TextBlock Text="{Binding Number}"
                                                                   Foreground="White"
                                                                   Margin="10, 5"
                                                                   FontWeight="Bold">
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </WrapPanel>
                                    </Grid>
                                </ControlTemplate>

                                <Style TargetType="ListViewItem">
                                    <Setter Property="Template" Value="{StaticResource ListViewPageItem}"/>
                                </Style>

                            </ListView.Resources>
                        </ListView>

                        <!-- Page Image Add Button -->
                        <Button Style="{StaticResource ImageDragAndDropPlace}"
                                Background="White"
                                Margin="15, 0, 0, 0"
                                Height="220" Width="150"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Content="Нажмите или перетащите сюда изображение для загрузки"
                                Drop="ImageAddDrop"
                                Click="ImageAddClick"/>
                    </Grid>
                </DockPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
