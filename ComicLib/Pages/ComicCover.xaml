<Page x:Class="ComicLib.Pages.ComicCover"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComicLib.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="740" d:DesignWidth="550"
      Title="ComicCover">

    <Grid x:Name="mainGrid" 
          Background="White"
          PreviewMouseDown="PageMouseDown">

        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            
            <!-- Comic All Info -->
            <StackPanel Orientation="Vertical"
                        Margin="30, 25, 30, 0">

                <!-- Comic Title -->
                <TextBlock FontWeight="Bold"
                           TextAlignment="Center"
                           Text="{Binding Title}"
                           HorizontalAlignment="Center"
                           Style="{StaticResource HeaderTextBlock}"
                           TextWrapping="Wrap"/>

                <!-- Horizontal Splitter -->
                <Rectangle Grid.Column="2"
                           Height="2"
                           Margin="50, 15"
                           VerticalAlignment="Top"
                           Fill="{StaticResource MainOrangeBrush}"/>

                <!-- Comic Info -->
                <TextBlock Text="Описание:"
                           Margin="0, 10"
                           FontSize="17"
                           Opacity="0.7"/>
                <TextBlock Text="{Binding Info}"
                           TextWrapping="Wrap"
                           FontSize="20"
                           Margin="10, 0"/>

                
                <!-- Genre List -->
                <TextBlock Text="Жанры:"
                           Margin="0, 10"
                           FontSize="17"
                           Opacity="0.7"/>
                <ListView x:Name="genreList"
                          ItemsSource="{Binding ComicAndGenre}"
                          SelectionMode="Extended"
                          BorderThickness="0"
                          Focusable="False">

                    <ListView.Template>
                        <ControlTemplate>
                            <ItemsPresenter></ItemsPresenter>
                        </ControlTemplate>
                    </ListView.Template>

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel x:Name="wrp" 
                                       Orientation="Horizontal"
                                       IsItemsHost="True"
                                       HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.Resources>
                        <ControlTemplate x:Key="listViewComicItem"
                                         TargetType="ListViewItem">

                            <Border x:Name="brd" Focusable="False"
                                    Background="{StaticResource MainOrangeBrush}"
                                    CornerRadius="5"
                                    Margin="0, 0, 10, 10"
                                    Padding="5">
                                <TextBlock Text="{Binding Genre.Title}"
                                           Foreground="White"
                                           Margin="10, 0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                        </ControlTemplate>

                        <Style TargetType="ListViewItem">
                            <Setter Property="Template" Value="{StaticResource listViewComicItem}"/>
                        </Style>

                    </ListView.Resources>

                </ListView>
                

                <!-- Tag List -->
                <TextBlock Text="Теги:"
                           Margin="0, 10"
                           FontSize="17"
                           Opacity="0.7"/>
                <ListView x:Name="tagList"
                          ItemsSource="{Binding ComicAndTag}"
                          SelectionMode="Extended"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">

                    <ListView.Template>
                        <ControlTemplate>
                            <ItemsPresenter></ItemsPresenter>
                        </ControlTemplate>
                    </ListView.Template>

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel x:Name="wrp" 
                                       Orientation="Horizontal"
                                       IsItemsHost="True"
                                       HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.Resources>
                        <ControlTemplate x:Key="listViewComicItem"
                                         TargetType="ListViewItem">

                            <Border x:Name="brd" Focusable="False"
                                    Background="{StaticResource MainOrangeBrush}"
                                    CornerRadius="5"
                                    Margin="0, 0, 10, 10"
                                    Padding="5">
                                <TextBlock Text="{Binding Tag.Title}"
                                           Foreground="White"
                                           Margin="10, 0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                        </ControlTemplate>

                        <Style TargetType="ListViewItem">
                            <Setter Property="Template" Value="{StaticResource listViewComicItem}"/>
                        </Style>

                    </ListView.Resources>

                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
