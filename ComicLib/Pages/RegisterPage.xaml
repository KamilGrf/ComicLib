<local:BasePage x:Class="ComicLib.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComicLib.Pages"
      xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1100"
      Title="RegisterPage">

    
    <Grid>
        <StackPanel Orientation="Vertical"
                    VerticalAlignment="Center"
                    Margin="0, 50, 0, 0"
                    Background="Transparent">
            
            <!-- Register Main Content White Border -->
            <Border Background="White"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    Height="600" Width="400">

                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0.5" Opacity="0.4" 
                                      BlurRadius="400" />
                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>
                        <!-- Sign Up Header -->
                        <RowDefinition/>
                        <!-- Username -->
                        <RowDefinition/>
                        <!-- Email -->
                        <RowDefinition/>
                        <!-- Password -->
                        <RowDefinition/>
                        <!-- Registration Button -->
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!-- Sign Up Header -->
                    <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Grid.Row="0">

                        <material:PackIcon Kind="Lock"
                                       Width="40" Height="40"
                                       VerticalAlignment="Center"
                                       Margin="0, 0, 10, 0"/>

                        <TextBlock Text="Регистрация"
                               FontFamily="Comic Sans MS"
                               FontSize="40" FontWeight="Bold"/>

                    </StackPanel>
                    <Rectangle Fill="Black" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Bottom"
                           Height="2" Width="350"
                           Grid.Row="0"/>

                    <!-- Username -->
                    <StackPanel Orientation="Vertical"
                            Grid.Row="1"
                            VerticalAlignment="Center">

                        <TextBlock Text="Логин"
                               FontFamily="Comic Sans MS"
                               HorizontalAlignment="Center"
                               FontSize="30"/>
                        <TextBox Text="Логин"
                             HorizontalAlignment="Center"
                             Width="300"
                             Margin="0, 5"
                             FontSize="30"/>

                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Orientation="Vertical"
                            Grid.Row="2"
                            VerticalAlignment="Center">

                        <TextBlock Text="Почта"
                               FontFamily="Comic Sans MS"
                               HorizontalAlignment="Center"
                               FontSize="30"/>
                        <TextBox Text="Почта"
                             HorizontalAlignment="Center"
                             Width="300"
                             Margin="0, 5"
                             FontSize="30"/>

                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Orientation="Vertical"
                            Grid.Row="3"
                            VerticalAlignment="Center">

                        <TextBlock Text="Пароль"
                               FontFamily="Comic Sans MS"
                               HorizontalAlignment="Center"
                               FontSize="30"/>
                        <TextBox Text="Пароль"
                             HorizontalAlignment="Center"
                             Width="300"
                             Margin="0, 5"
                             FontSize="30"/>

                    </StackPanel>

                    <!-- Registration Button -->
                    <Button Grid.Row="4"
                            Style="{StaticResource RegistrationButton}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="260" Height="70" Click="RegClick">

                        <TextBlock Text="Зарегистрироваться"
                                   FontSize="25"/>
                    </Button>

                </Grid>

            </Border>

            <!-- Login Page Button -->
            <Button HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource TextButton}"
                    Margin="0, 0, 0, 90"
                    FontSize="20"
                    Click="LoginPageClick">
                Или у вас уже есть аккаунт...
            </Button>
            
        </StackPanel>
    </Grid>
</local:BasePage>
