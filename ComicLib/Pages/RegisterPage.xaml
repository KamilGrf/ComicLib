<local:BasePage x:Class="ComicLib.Pages.RegisterPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                xmlns:local="clr-namespace:ComicLib.Pages"
                xmlns:allLocal="clr-namespace:ComicLib"
                xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
                mc:Ignorable="d" 
                d:DesignHeight="900" d:DesignWidth="1100"
                Title="RegisterPage">

    <local:BasePage.Resources>
        <Style TargetType="PasswordBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=accept, Path=IsChecked}" 
                             Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" x:Key="PasswordTextBox" BasedOn="{StaticResource RegularTextBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=accept, Path=IsChecked}" 
                             Value="False">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </local:BasePage.Resources>

    <local:BasePage.CacheMode>
        <BitmapCache/>
    </local:BasePage.CacheMode>

    <Grid>
        <StackPanel Orientation="Vertical"
                    VerticalAlignment="Center"
                    Margin="0, 50, 0, 0"
                    Background="Transparent">
            
            <!-- Register Main Content White Border -->
            <Border Background="White"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    Height="650" Width="400">

                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0.5" Opacity="0.4" 
                                      BlurRadius="400" />
                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>
                        <!-- Sign Up Header -->
                        <RowDefinition Height="150"/>
                        <!-- Username -->
                        <RowDefinition/>
                        <!-- Email -->
                        <RowDefinition Height="120"/>
                        <!-- Password -->
                        <RowDefinition Height="140"/>
                        <!-- Registration Button -->
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!-- Sign Up Header -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0, 30"
                                Grid.Row="0">

                        <material:PackIcon Kind="Lock"
                                           Width="40" Height="40"
                                           VerticalAlignment="Center"
                                           Margin="0, 0, 10, 0"/>

                        <TextBlock Text="Регистрация"
                                   FontFamily="Comic Sans MS"
                                   FontSize="40" FontWeight="Bold"/>

                    </StackPanel>
                    
                    <!-- Horizontal Splitter -->
                    <Rectangle Fill="Black" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Bottom"
                               Height="2" Width="350"
                               Grid.Row="0"
                               Margin="0, 35"/>

                    <!-- Error Message -->
                    <TextBlock x:Name="errorMes" 
                               HorizontalAlignment="Center"
                               FontSize="15"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="15, 15, 15, 15"
                               Grid.RowSpan="2"
                               VerticalAlignment="Center"
                               Foreground="Red"/>

                    <!-- Username -->
                    <StackPanel Orientation="Vertical"
                                Grid.Row="1"
                                VerticalAlignment="Bottom">

                        <TextBlock Text="Логин"
                                   FontFamily="Comic Sans MS"
                                   HorizontalAlignment="Center"
                                   FontSize="30"/>
                        <TextBox x:Name="login" 
                                 Style="{StaticResource RegularTextBox}"
                                 PreviewTextInput="LoginPreviewTextInput"
                                 PreviewKeyDown="TextBoxPreviewKeyDown"
                                 HorizontalAlignment="Center"
                                 MaxLength="20"
                                 Width="300"
                                 Margin="0, 5"
                                 FontSize="30"/>

                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Orientation="Vertical"
                                Grid.Row="2"
                                VerticalAlignment="Center">

                        <TextBlock Text="Почта"
                                   FontFamily="Comic Sans MS"
                                   HorizontalAlignment="Center"
                                   FontSize="30"/>
                        <TextBox x:Name="email" 
                                 Style="{StaticResource RegularTextBox}"
                                 PreviewTextInput="EmailPreviewTextInput"
                                 PreviewKeyDown="TextBoxPreviewKeyDown"
                                 HorizontalAlignment="Center"
                                 MaxLength="50"
                                 Width="300"
                                 Margin="0, 5"
                                 FontSize="30"/>

                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Orientation="Vertical"
                                Grid.Row="3"
                                VerticalAlignment="Center">

                        <TextBlock Text="Пароль"
                                   FontFamily="Comic Sans MS"
                                   HorizontalAlignment="Center"
                                   FontSize="30"/>
                        <Grid Width="300"
                              HorizontalAlignment="Center">

                            <!-- Hidden Password -->
                            <PasswordBox x:Name="firstPassword" PasswordChar="*"
                                         Style="{StaticResource RegularPasswordBox}"
                                         Margin="0, 5"
                                         FontSize="30"
                                         MaxLength="20"
                                         FontFamily="Comic Sans MS"
                                         PreviewTextInput="PasswordPreviewTextInput"
                                         PreviewKeyDown="TextBoxPreviewKeyDown"
                                         allLocal:PasswordHelper.Attach="True"
                                         allLocal:PasswordHelper.Password="{Binding Path=Text, 
                                ElementName=pas, Mode=TwoWay}"/>
                            <!-- Visible Password -->
                            <TextBox x:Name="pas"
                                     Style="{StaticResource PasswordTextBox}"
                                     MaxLength="20"
                                     FontFamily="Comic Sans MS"
                                     Margin="0, 5"
                                     FontSize="30"
                                     PreviewTextInput="PasswordPreviewTextInput"
                                     PreviewKeyDown="TextBoxPreviewKeyDown"/>
                        </Grid>

                        <!-- Accept Toggle Button -->
                        <ToggleButton x:Name="accept" 
                                      Style="{StaticResource CheckBoxToggleButtonTemplate}"
                                      HorizontalAlignment="Left"
                                      Margin="50, 10">
                            <TextBlock Margin="10, 0"
                                       Text="Показать пароль"
                                       FontSize="16"
                                       TextWrapping="Wrap"/>
                        </ToggleButton>

                    </StackPanel>

                    <!-- Registration Button -->
                    <Button Grid.Row="4"
                            Style="{StaticResource RegistrationButton}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="260" Height="70" Click="RegClick">

                        <TextBlock Text="Зарегистрироваться"
                                   FontSize="25"/>
                    </Button>

                </Grid>

            </Border>

            <!-- Login Page Button -->
            <Button HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource TextButton}"
                    Margin="0, 0, 0, 90"
                    FontSize="20"
                    Click="LoginPageClick">
                Или у вас уже есть аккаунт...
            </Button>
            
        </StackPanel>
    </Grid>
</local:BasePage>
