<Window x:Class="ComicLib.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComicLib"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="Images/books.png"
        Title="MainWindow" Height="918" Width="1124"
        MinHeight="918" MinWidth="1124"
        WindowStartupLocation="CenterScreen">

    
    <Window.Resources>
        <Style TargetType="local:MainWindow">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Window">
                        <Border Padding="0"
                                BorderBrush="#FFBDBDBD"
                                BorderThickness="0">
                            <Grid Background="White">
                                <Border Background="White">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0.5" Opacity="0.2" />
                                    </Border.Effect>
                                </Border>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    
                                    <Grid Grid.Column="0"
                                          MouseDown="GridDragMoveMouseDown"
                                          Background="Transparent"
                                          WindowChrome.IsHitTestVisibleInChrome="True">

                                        <Grid.ColumnDefinitions>
                                            <!-- Icon -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Title -->
                                            <ColumnDefinition Width="*" />
                                            <!-- Windows Button -->
                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <!-- Icon -->
                                        <Button Click="MenuClick">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border Background="Transparent"
                                                            Padding="3">
                                                        <ContentPresenter VerticalAlignment="Center"
                                                                          HorizontalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Image Source="/Images/books.png" />
                                        </Button>

                                        <!-- Title -->
                                        <!--<Viewbox Grid.Column="0" Grid.ColumnSpan="3" Margin="5">
                                            <StackPanel>
                                                <TextBlock FontFamily="{StaticResource LatoBold}" FontSize="{StaticResource FontSizeLarge}" Margin="0,0,0,-5">
                                                    <Run Text="W" Foreground="{StaticResource WordOrangeBrush}" />--><!--
                                                    --><!--<Run Text="O" Foreground="{StaticResource WordBlueBrush}" />--><!--
                                                    --><!--<Run Text="R" Foreground="{StaticResource WordRedBrush}" />--><!--
                                                    --><!--<Run Text="D" Foreground="{StaticResource WordGreenBrush}" />
                                                </TextBlock>
                                                <TextBlock Text="by fasetto" Foreground="{StaticResource ForegroundDarkBrush}" TextAlignment="Center" />
                                            </StackPanel>
                                        </Viewbox>

                                        --><!-- Window Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Click="MinimizeClick" Style="{StaticResource WindowControlButton}" Content="_"/>
                                            <Button Click="MaximizeClick" Style="{StaticResource WindowControlButton}" Content="[ ]"/>
                                            <Button Click="CloseClick" Style="{StaticResource WindowCloseButton}" Content="X" 
                                                    Width="40"
                                                    FontSize="14"/>
                                        </StackPanel>

                                    </Grid>
                                    
                                    <Border Grid.Row="2" Padding="0" ClipToBounds="True">
                                        <ContentPresenter Content="{TemplateBinding Content}" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="0"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Frame x:Name="mainFrame"
               NavigationUIVisibility="Hidden">
            
        </Frame>
    </Grid>
    
