<Window x:Class="ComicLib.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComicLib"
        xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="Images/books.png"
        Title="MainWindow" Height="918" Width="1124"
        MinHeight="918" MinWidth="1124"
        WindowStartupLocation="CenterScreen">


    <Window.Resources>
        <Style TargetType="{x:Type local:MainWindow}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Window">

                        <Border Padding="5"
                                BorderBrush="#FFBDBDBD"
                                BorderThickness="0">

                            <Grid>

                                <!-- Window Shadow Effect -->
                                <Border x:Name="background"
                                        CornerRadius="3"
                                        Background="{StaticResource MainYellowRedBackgroundGradient}">

                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0.5" Opacity="0.2" 
                                                          BlurRadius="10" />
                                    </Border.Effect>

                                </Border>

                                <Grid>
                                    <!-- Page Background Image Brush -->
                                    <Grid.Background>
                                        <ImageBrush ImageSource="/Images/comic-background.png"
                                                    TileMode="Tile"
                                                    ViewportUnits="Absolute"
                                                    Viewport="0 0 500 300"
                                                    Opacity="0.15"/>
                                    </Grid.Background>

                                    <!-- Page Content -->
                                    <Border Padding="0" ClipToBounds="True">
                                        <ContentPresenter Content="{TemplateBinding Content}" />
                                    </Border>
                                </Grid>

                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="4" 
                      CaptionHeight="42"
                      CornerRadius="5"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>


    <Grid>

        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="42"/>
            <!-- Page Content -->
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border
                CornerRadius="2, 2, 0, 0">
            <Border.Background>
                <SolidColorBrush Color="#FF93D8F7"/>
            </Border.Background>

            <Grid Grid.Column="0"
                  WindowChrome.IsHitTestVisibleInChrome="True">

                <Grid.ColumnDefinitions>
                    <!-- Icon -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Title -->
                    <ColumnDefinition Width="*" />
                    <!-- Window Buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Button Click="MenuClick">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="Transparent"
                                    Padding="3">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Image Source="/Images/books.png" />
                </Button>

                <!-- Title -->
                <TextBlock Text="ComicLib"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Grid.Column="1"
                           Margin="10, 0"
                           FontSize="30"
                           WindowChrome.IsHitTestVisibleInChrome="False">
                    <TextBlock.Foreground>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black" Offset="1"/>
                            <GradientStop Color="Red"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <!-- Window Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <Button Click="MinimizeClick" Style="{StaticResource WindowControlButton}"
                            Width="40">
                        <material:PackIcon Kind="WindowMinimize"
                                           Height="15" Width="15"/>
                    </Button>

                    <Button Click="MaximizeClick" Style="{StaticResource WindowControlButton}"
                            Width="40">
                        <material:PackIcon x:Name="maximize" Kind="WindowMaximize"
                                           Height="17" Width="17"/>
                    </Button>

                    <Button Click="CloseClick" Style="{StaticResource WindowCloseButton}"
                            Width="50">
                        <material:PackIcon Kind="WindowClose"
                                           Height="20" Width="20"/>
                    </Button>

                </StackPanel>

            </Grid>
        </Border>

        <!-- Main Frame -->
        <Frame x:Name="mainFrame"
               NavigationUIVisibility="Hidden"
               Grid.Row="1"
               Focusable="False">

        </Frame>
    </Grid>
</Window>
