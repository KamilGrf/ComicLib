<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window Control Button -->
    <Style TargetType="Button" x:Key="WindowControlButton">
        
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="Black" />
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="{TemplateBinding Padding}" 
                            Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" 
                                          HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TitleMouseDownBackgroundBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>

    </Style>

    <!-- Window Close Button -->
    <Style TargetType="Button" x:Key="WindowCloseButton" 
           BasedOn="{StaticResource WindowControlButton}">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="{TemplateBinding Padding}" 
                            Background="{TemplateBinding Background}"
                            CornerRadius="0, 2, 0, 0">
                        <ContentPresenter VerticalAlignment="Center" 
                                          HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Red" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>

    </Style>

    <!-- View Port Header Button -->
    <Style TargetType="Button" x:Key="ViewPortHeaderButton">

        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{StaticResource ViewPortMouseDownBackgroundBrush}"/>
            </Trigger>
        </Style.Triggers>
        
    </Style>

    <!-- Profile Button -->
    <Style TargetType="Button" x:Key="ViewPortProfileButton"
           BasedOn="{StaticResource ViewPortHeaderButton}">

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>

    </Style>


    <!-- Authorization Button -->
    <Style TargetType="Button" x:Key="RegistrationButton">

        <Setter Property="FontFamily" Value="Comic Sans MS"/>
        <Setter Property="Foreground" Value="White"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border x:Name="back" 
                            Background="{StaticResource MainDimOrangeBrush}"
                            CornerRadius="10">
                        <ContentPresenter 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation To="#3099C5" Duration="0:0:0.1" Storyboard.TargetName="back" Storyboard.TargetProperty="Background.Color" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation From="#3099C5" Duration="0:0:0.1" Storyboard.TargetName="back" Storyboard.TargetProperty="Background.Color" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
    </Style>
    
    
    <!-- Text Button -->
    <Style TargetType="Button" x:Key="TextButton">

        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Comic Sans MS"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border Background="Transparent">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontSize="{TemplateBinding FontSize}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="10, 5"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource MainOrangeBrush}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Toggle Switch Button -->
    <Style TargetType="ToggleButton" x:Key="ToggleSwitchButton">

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border" 
                            Background="#FFDDDDDD"
                            CornerRadius="15">

                        <Canvas>
                            <Ellipse x:Name="toggle" 
                                     Width="{TemplateBinding Height}"
                                     Height="{TemplateBinding Height}"
                                     Fill="#FF627285" 
                                     Canvas.Left="0">
                            </Ellipse>
                        </Canvas>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Control.Visibility" Value="Hidden" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">

                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CogAnimation">
                                    <Storyboard>

                                        <DoubleAnimation 
                                            Storyboard.TargetName="toggle" 
                                            Storyboard.TargetProperty="(Canvas.Left)"
                                            Duration="0:0:0.2"
                                            From="0" To="30"/>
                                        <ColorAnimation 
                                            To="#FF59C51B" 
                                            Duration="0:0:0.2"
                                            Storyboard.TargetName="toggle" 
                                            Storyboard.TargetProperty="Fill.Color"/>
                                        <ColorAnimation 
                                            To="#FFFFC500" 
                                            Duration="0:0:0.2"
                                            Storyboard.TargetName="border" 
                                            Storyboard.TargetProperty="Background.Color"/>

                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CogAnimationn">
                                    <Storyboard>

                                        <DoubleAnimation 
                                            Storyboard.TargetName="toggle" 
                                            Storyboard.TargetProperty="(Canvas.Left)"
                                            Duration="0:0:0.2"
                                            From="30" To="0"/>
                                        <ColorAnimation 
                                            To="#FF627285" 
                                            Duration="0:0:0.2"
                                            Storyboard.TargetName="toggle" 
                                            Storyboard.TargetProperty="Fill.Color"/>
                                        <ColorAnimation 
                                            To="#FFDDDDDD" 
                                            Duration="0:0:0.2"
                                            Storyboard.TargetName="border" 
                                            Storyboard.TargetProperty="Background.Color"/>

                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>

                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>