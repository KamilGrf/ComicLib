<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Header Text Block -->
    <Style TargetType="TextBlock" x:Key="HeaderTextBlock">
        
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="Margin" Value="0, 20, 0, 5"/>
        <Setter Property="FontFamily" Value="Comic Sans MS"/>
        
    </Style>
    
    <!-- Data Edit Text Box -->
    <Style TargetType="TextBox" x:Key="DataEditTextBox">

        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="Comic Sans MS"/>
        <Setter Property="Padding" Value="10, 0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">

                    <Border x:Name="border"
                            CornerRadius="4"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="2"
                            Background="{TemplateBinding Background}">

                        <ScrollViewer x:Name="PART_ContentHost"
                                    Focusable="false"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden"/>
                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
    </Style>

    <!-- Search Bar Text Box -->
    <Style TargetType="TextBox" x:Key="SearchTextBox">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    
                    <Border x:Name="border"
                            CornerRadius="4"
                            BorderBrush="{StaticResource TextBoxBorderBrush}"
                            BorderThickness="2"
                            Background="{TemplateBinding Background}">
                        <Grid Margin="6, 0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                    Focusable="false"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden"/>

                            
                        </Grid>
                        
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="IBeam"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource MainOrangeBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
    </Style>

    <!-- Menu Content Background Button -->
    <Style TargetType="Button" x:Key="MenuTemplate">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border Background="White"
                            CornerRadius="5"
                            Height="{TemplateBinding Height}"
                            Width="{TemplateBinding Width}">

                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0.5" Opacity="0.4" 
                                              BlurRadius="10" />
                        </Border.Effect>

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="10"/>
                    </Border>
                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
    </Style>

    <!-- Menu Content Background List Box -->
    <Style TargetType="ListBox" x:Key="ListBoxMenuTemplate">

        <Setter Property="Background" Value="White"/>   

        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0.5" Opacity="0.4" 
                                              BlurRadius="10" />
            </Setter.Value>
        </Setter>

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">

                                <Border x:Name="back" Background="White"
                                        CornerRadius="5"
                                        Height="40"
                                        Margin="2">

                                    <ContentPresenter Margin="10, 0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"/>

                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter TargetName="back" 
                                                Property="Background"
                                                Value="LightGray"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>

                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                </Style>
            </Setter.Value>
        </Setter>
        
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
        </Style.Resources>
        
    </Style>
    
</ResourceDictionary>