<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="MainBlue">#FF00B9FF</Color>
    <SolidColorBrush x:Key="MainBlueBrush" Color="{StaticResource MainBlue}"/>

    <Color x:Key="MouseDownBackground">#FF90909E</Color>
    <SolidColorBrush x:Key="MouseDownBackgroundBrush" Color="{StaticResource MouseDownBackground}"/>

    <Color x:Key="TitleBarBackground">#FFD9D9EE</Color>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource TitleBarBackground}"/>

</ResourceDictionary>